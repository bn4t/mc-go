FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git ripgrep \
    && rm -rf /var/lib/apt/lists/*

USER node
ENV HOME=/home/node
ENV PATH="/home/node/.local/bin:/home/node/.npm-global/bin:${PATH}"
RUN npm config set prefix /home/node/.npm-global \
    && git config --global --add safe.directory '*'

RUN PRIME_AGENT_BOOTSTRAP_TOOLS_ON_INSTALL=1 \
    PRIME_AGENT_BOOTSTRAP_KERNEL_ON_INSTALL=1 \
    PRIME_AGENT_INSTALL_UV=1 \
    sh -c 'curl -fsSL https://app.primeintellect.ai/prime-agent/install.sh | sh'

WORKDIR /work
ENTRYPOINT ["prime-agent"]
